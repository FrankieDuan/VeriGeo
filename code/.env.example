# ===== VeriGeo engine (required) =====
VERIGEO_API_KEY=sk-REPLACE_ME
VERIGEO_API_ENDPOINT=https://your-openai-compatible-endpoint.example.com
VERIGEO_MODEL=claude-sonnet-4-5-20250929

# ===== Multi-model generation (optional, LLM_<NAME>_*) =====
# Each <NAME> below maps to one entry in generate/models.py. Endpoints
# must be set explicitly; API keys default to VERIGEO_API_KEY when the
# per-model LLM_<NAME>_API_KEY is left blank.

# Gemini
LLM_GEMINI_ENDPOINT=
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.5-pro

# Claude Opus
LLM_CLAUDE_OPUS_ENDPOINT=
LLM_CLAUDE_OPUS_API_KEY=
LLM_CLAUDE_OPUS_MODEL=claude-opus-4

# GPT-4o-mini / GPT-4o
LLM_GPT_MINI_ENDPOINT=
LLM_GPT_MINI_API_KEY=
LLM_GPT_MINI_MODEL=gpt-4o-mini
LLM_GPT_ENDPOINT=
LLM_GPT_API_KEY=
LLM_GPT_MODEL=gpt-4o

# DeepSeek (direct)
LLM_DEEPSEEK_ENDPOINT=
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODEL=deepseek-chat

# DeepSeek (alternative routing)
LLM_DEEPSEEK_BAILIAN_ENDPOINT=
LLM_DEEPSEEK_BAILIAN_API_KEY=
LLM_DEEPSEEK_BAILIAN_MODEL=deepseek-chat

# Qwen
LLM_QWEN_ENDPOINT=
LLM_QWEN_API_KEY=
LLM_QWEN_MODEL=qwen-plus

# ===== Optional: LLM disk-cache controls =====
# LLM_CACHE_ENABLE=1
# LLM_CACHE_DIR=/path/to/cache
# LLM_CACHE_TTL=604800
